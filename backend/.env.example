# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/eotm

# Signs the app's session cookie. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_MINUTES=480
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# Microsoft Entra ID app registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Optional: Entra group object IDs mapped to app roles
ENTRA_GROUP_ADMIN=
ENTRA_GROUP_HR=
# Optional: if set, only members of this group (plus HR/admin) can sign in
ENTRA_GROUP_EMPLOYEE=

# Development-only sign-in that bypasses Microsoft. NEVER enable in production.
AUTH_DEV_MODE=false

CORS_ORIGINS=["http://localhost:5173"]
